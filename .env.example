# Gemini LLM & Embeddings Configuration
GEMINI_API_KEY="your-gemini-api-key"
# Optional separate key for embeddings if desired (falls back to GEMINI_API_KEY)
GEMINI_EMBEDDING_API_KEY=""

# Model Selections
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Vector Store & Cache Path
CODEBASE_CACHE_DIR=".codebase_assistant"

# Retrieval & Context Limits
MAX_CONTEXT_TOKENS=8192
DEFAULT_TOP_K=5

# Agent Guardrails & Limits
MAX_TOOL_CALLS_PER_TURN=5
MAX_REASONING_STEPS=10
COMMAND_TIMEOUT_SECONDS=30
REQUIRE_CONFIRMATION_FOR_MUTATIONS=true
